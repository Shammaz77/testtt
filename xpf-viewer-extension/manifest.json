{
  "manifest_version": 3,
  "name": "Sheet XPF Viewer",
  "version": "1.0.0",
  "description": "Renders SheetXPF .xpf files in Chrome.",
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://*/*.xpf*",
        "https://*/*.xpf*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
